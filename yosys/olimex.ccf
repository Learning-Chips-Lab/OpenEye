# ====================================================================
# Olimex GateMate EVB - Pin Constraints File (CCF)
# Design: OpenEye_FPGA (DMA Interface)
# ====================================================================

# --------------------------------------------------------------------
# Globals (Clock & Reset)
# --------------------------------------------------------------------
Pin_in  "clk_i"        Loc = "IO_SB_A8"; # 10 MHz On-Board Oscillator (oder FPLL Input)
Pin_in  "rst_ni"       Loc = "IO_EB_B8"; # Beispiel: Zuordnung zu einem Taster oder GPIO

# --------------------------------------------------------------------
# DMA Control Signals
# --------------------------------------------------------------------
Pin_out "ready_dma_o"  Loc = "IO_NB_A8";
Pin_in  "enable_dma_i" Loc = "IO_NB_B8";
Pin_in  "ready_dma_i"  Loc = "IO_NA_A8";
Pin_out "enable_dma_o" Loc = "IO_NA_B8";
Pin_out "last_data_o"  Loc = "IO_WB_B8";

# --------------------------------------------------------------------
# Input DMA Bus: data_dma_i [63:0]
