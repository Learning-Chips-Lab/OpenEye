SRC_DIRS := ../hdl/
TOP_MODULE := adder
OUT_JSON := $(TOP_MODULE).json
VERILOG_SRCS := $(shell find $(SRC_DIRS) -name "*.v" | sort)

GEN_SCRIPT := gen_synth.ys

all: $(GEN_SCRIPT)
	yosys  $(GEN_SCRIPT)

$(GEN_SCRIPT):
	@echo "Verilog sources:"
	@echo $(VERILOG_SRCS) | tr ' ' '\n'
	@echo "Generating Yosys synth script with SYNTHESIS macro..."
	@echo "# Auto-generated by Makefile" > $(GEN_SCRIPT)
	@for f in $(VERILOG_SRCS); do \
		echo "read_verilog -D SYNTHESIS $$f" >> $(GEN_SCRIPT); \
	done
	@echo "" >> $(GEN_SCRIPT)
	@echo "synth_gatemate -top $(TOP_MODULE) -json $(OUT_JSON)" >> $(GEN_SCRIPT)
	@cat $(GEN_SCRIPT)

clean:
	rm -f *.json *.log *.dot *.svg $(GEN_SCRIPT)